{
  "name": "vorwahlen-quiz",
  "productName": "Vorwahlen-Quiz",
  "version": "1.0.0",
  "description": "Telefonvorwahlen der USA, Brasiliens und Indonesiens auf der Karte lernen",
  "author": "MebTobi",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "copy-web": "node copy-web.js",
    "start": "npm run copy-web && electron .",
    "dist:win": "npm run copy-web && electron-builder --win nsis portable zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.mebtobi.vorwahlenquiz",
    "productName": "Vorwahlen-Quiz",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Vorwahlen-Quiz-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Vorwahlen-Quiz-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vorwahlen-Quiz",
      "language": "1031",
      "artifactName": "Vorwahlen-Quiz-Setup-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MebTobi/python-grundkurs-2685000.git"
  }
}
